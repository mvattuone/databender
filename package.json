{
  "name": "databender",
  "version": "2.0.0-alpha.3",
  "description": "Create interesting visuals by misusing the Web Audio API",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./dist/databender.js": "./dist/databender.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepack": "npm test && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "glitch",
    "art",
    "databend",
    "web",
    "audio"
  ],
  "author": "Mike Vattuone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvattuone/databender.git"
  },
  "homepage": "https://github.com/mvattuone/databender#readme",
  "bugs": {
    "url": "https://github.com/mvattuone/databender/issues"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.8",
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.52.4"
  }
}
